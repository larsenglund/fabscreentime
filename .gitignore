# Build output
/bin/
/dist/
/agentrelease/
*.exe

# Frontend: node_modules is not committed, but web/dist IS (it is embedded into
# the backend binary by web/embed.go, so `go build` and CI need it present).
/web/node_modules/
/web/*.tsbuildinfo
.vite/

# Local runtime state
*.db
*.db-wal
*.db-shm
montest*.csv
/.fabscreentime/
/agentdata/
/run/
queue.json
device_id
credentials.json
enroll.json

# Signing keys — NEVER commit the private update-signing key
*.key
release.key
manifest.json

# Editor / OS
.DS_Store
.idea/
.vscode/
